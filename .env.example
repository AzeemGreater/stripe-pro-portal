# Shield Pro Portal Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# JWT Secret (use a long random string)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_STRING_MIN_64_CHARS

# Encryption key for sensitive data (Stripe keys, etc.) - must be 32 chars
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_KEY_FOR_AES256

# Admin credentials (set once at startup)
ADMIN_EMAIL=admin@azeemgreater.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Portal URL
PORTAL_URL=https://stripe.azeemgreater.com

# WordPress activation server (existing azeemgreater.com)
WP_ACTIVATION_SERVER=https://azeemgreater.com

# SQLite database path
DB_PATH=./database/portal.db
